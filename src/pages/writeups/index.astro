---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const writeups = (await getCollection("writeups")).sort((a, b) => a.data.level - b.data.level);
const platforms = [...new Set(writeups.map((entry) => entry.data.platform))];
const categories = [...new Set(writeups.map((entry) => entry.data.category))];
const difficulties = [...new Set(writeups.map((entry) => entry.data.difficulty))];
const base = import.meta.env.BASE_URL;
---

<StarlightPage frontmatter={{ title: "Writeups", description: "Browse and filter CTF walkthroughs by platform, category, difficulty, or tag." }}>
  <p class="writeup-index-intro">Search the collection or combine filters to find a challenge.</p>

  <form class="filter-bar" id="writeup-filters" aria-label="Filter writeups">
    <label class="search-field">
      <span>Search</span>
      <input id="writeup-search" type="search" placeholder="Title, game, or tag…" autocomplete="off" />
    </label>
    <label><span>Platform</span><select id="platform-filter"><option value="">All platforms</option>{platforms.map((item) => <option value={item.toLowerCase()}>{item}</option>)}</select></label>
    <label><span>Category</span><select id="category-filter"><option value="">All categories</option>{categories.map((item) => <option value={item.toLowerCase()}>{item}</option>)}</select></label>
    <label><span>Difficulty</span><select id="difficulty-filter"><option value="">All difficulties</option>{difficulties.map((item) => <option value={item.toLowerCase()}>{item}</option>)}</select></label>
    <button type="reset">Clear filters</button>
  </form>

  <p class="result-count" id="result-count" aria-live="polite">{writeups.length} {writeups.length === 1 ? "writeup" : "writeups"}</p>

  <div class="writeup-grid filterable-grid" id="writeup-grid">
    {writeups.map((entry) => (
      <a
        class="writeup-card"
        href={`${base}/writeups/${entry.id}/`}
        data-search={[entry.data.title, entry.data.platform, entry.data.game, entry.data.category, ...entry.data.tags].join(" ").toLowerCase()}
        data-platform={entry.data.platform.toLowerCase()}
        data-category={entry.data.category.toLowerCase()}
        data-difficulty={entry.data.difficulty.toLowerCase()}
      >
        <div class="card-meta"><span>{entry.data.platform} / {entry.data.game}</span><span class={`difficulty difficulty-${entry.data.difficulty.toLowerCase()}`}>{entry.data.difficulty}</span></div>
        <h2>{entry.data.title}</h2>
        <p>{entry.data.description}</p>
        <div class="tag-row">{entry.data.tags.map((tag) => <span class="tag">#{tag}</span>)}</div>
      </a>
    ))}
  </div>
  <div class="empty-state" id="empty-state" hidden>
    <strong>No writeups found.</strong>
    <p>Try removing a filter or using a broader search term.</p>
  </div>
</StarlightPage>

<script>
  const form = document.querySelector<HTMLFormElement>("#writeup-filters");
  const search = document.querySelector<HTMLInputElement>("#writeup-search");
  const platform = document.querySelector<HTMLSelectElement>("#platform-filter");
  const category = document.querySelector<HTMLSelectElement>("#category-filter");
  const difficulty = document.querySelector<HTMLSelectElement>("#difficulty-filter");
  const cards = [...document.querySelectorAll<HTMLElement>("#writeup-grid .writeup-card")];
  const count = document.querySelector<HTMLElement>("#result-count");
  const empty = document.querySelector<HTMLElement>("#empty-state");

  const applyFilters = () => {
    const query = search?.value.trim().toLowerCase() ?? "";
    let visible = 0;
    for (const card of cards) {
      const matches = (!query || card.dataset.search?.includes(query)) &&
        (!platform?.value || card.dataset.platform === platform.value) &&
        (!category?.value || card.dataset.category === category.value) &&
        (!difficulty?.value || card.dataset.difficulty === difficulty.value);
      card.hidden = !matches;
      if (matches) visible += 1;
    }
    if (count) count.textContent = `${visible} ${visible === 1 ? "writeup" : "writeups"}`;
    if (empty) empty.hidden = visible !== 0;
  };

  form?.addEventListener("input", applyFilters);
  form?.addEventListener("reset", () => setTimeout(applyFilters));
</script>
